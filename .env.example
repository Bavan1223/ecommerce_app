# Flask Configuration
SECRET_KEY=your-super-secret-key-change-in-production
PORT=5001

# Firebase Authentication & Firestore (Free Tier - NO Firebase Storage)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Optional: Path to serviceAccountKey.json for local development
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Firebase Web Config (For Google Sign-In on client side)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Cloudinary (Free Tier image storage for products and profile pictures)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (TEST MODE for local & college demo - e.g. rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
